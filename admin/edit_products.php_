<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);

if(session_status() === PHP_SESSION_NONE) {
    session_start();
}

// Check admin authentication
if(!isset($_SESSION['admin_id'])) {
    header("Location: login.php");
    exit();
}

include "db-conn.php";

if (!isset($_GET['edit_product_details'])) {
    die("Product ID is missing from the URL.");
}

$product_id = intval($_GET['edit_product_details']);

// Fetch product details with prepared statement
$query = "SELECT p.*, 
          COALESCE(c.categories, pc.categories) as category_name,
          sc.categories as subcategory_name,
          COALESCE(p.pro_cate, pc.cate_id) as resolved_cate_id
          FROM products p 
          LEFT JOIN categories c ON p.pro_cate = c.cate_id 
          LEFT JOIN sub_categories sc ON p.pro_sub_cate = sc.id
          LEFT JOIN categories pc ON sc.parent_id = pc.cate_id
          WHERE p.pro_id = ?";
          
$stmt = $conn->prepare($query);
$stmt->bind_param("i", $product_id);
$stmt->execute();
$result = $stmt->get_result();

if ($result && mysqli_num_rows($result) > 0) {
    $product = mysqli_fetch_assoc($result);
} else {
    die("Product not found.");
}
$stmt->close();

// Fetch categories
$category_query = "SELECT * FROM `categories` ORDER BY categories";
$categories_result = mysqli_query($conn, $category_query);

// Add image_fx column if not exists
$check_column = mysqli_query($conn, "SHOW COLUMNS FROM products LIKE 'image_fx'");
if(mysqli_num_rows($check_column) == 0) {
    mysqli_query($conn, "ALTER TABLE products ADD COLUMN image_fx TEXT DEFAULT NULL AFTER text_zones");
}

// Check if editor_config column exists
$check_ec = mysqli_query($conn, "SHOW COLUMNS FROM products LIKE 'editor_config'");
if(mysqli_num_rows($check_ec) == 0) {
    mysqli_query($conn, "ALTER TABLE products ADD COLUMN editor_config TEXT DEFAULT NULL AFTER text_zones");
}

// Load Google Fonts list
include_once 'google_fonts_list.php';

// Get all fonts
$allGoogleFonts = array_keys($GOOGLE_FONTS);
$system_fonts = ['Arial','Georgia','Impact','Verdana','Times New Roman','Tahoma','Courier New','Palatino','Garamond','Comic Sans MS','Lucida Console','Trebuchet MS'];

// Filter Google Fonts (exclude system fonts)
$gf_to_load = array_diff($allGoogleFonts, $system_fonts);

// Limit to first 100 fonts for performance (adjust as needed)
$gf_to_load = array_slice($gf_to_load, 0, 100, true);

// Build Google Fonts URL
$gf_url = 'https://fonts.googleapis.com/css2?';
$font_params = array_map(function($f) { 
    return 'family=' . urlencode($f) . ':wght@400;700'; 
}, $gf_to_load);
$gf_url .= implode('&', array_slice($font_params, 0, 50)) . '&display=swap'; // Limit to 50 font families per request

// Parse editor config
$editor_config = [];
if (!empty($product['editor_config'])) {
    $decoded = json_decode($product['editor_config'], true);
    if (is_array($decoded)) {
        $editor_config = $decoded;
    }
}

// Helper function for checkbox checked state
function ec($key, $cfg) { 
    return !empty($cfg[$key]) ? 'checked' : ''; 
}

// Get saved fonts or all fonts
$saved_fonts = !empty($editor_config['fonts']) ? $editor_config['fonts'] : $allGoogleFonts;

// Escape product data for JavaScript
$product_img = !empty($product['pro_img']) ? 'assets/img/uploads/' . $product['pro_img'] : '';
$text_zones_json = !empty($product['text_zones']) ? $product['text_zones'] : '[]';
$image_fx_json = !empty($product['image_fx']) ? $product['image_fx'] : '{}';
?>

